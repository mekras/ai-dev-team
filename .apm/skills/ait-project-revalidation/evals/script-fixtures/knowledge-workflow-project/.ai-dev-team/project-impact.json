{
  "schema_version": 1,
  "name": "knowledge-workflow",
  "nodes": [
    {
      "id": "concept",
      "title": "Концепция",
      "kind": "concept",
      "paths": ["docs/concept.md"],
      "checks": ["ait-docs-concept"],
      "review_stages": ["requirements"]
    },
    {
      "id": "knowledge",
      "title": "Корпус знаний",
      "kind": "knowledge",
      "paths": ["knowledge/corpus.yml"],
      "checks": ["kc-validation"],
      "review_stages": ["repository"]
    },
    {
      "id": "requirements",
      "title": "Требования",
      "kind": "requirements",
      "paths": ["docs/concept.md"],
      "checks": ["ait-req-revalidation"],
      "review_stages": ["requirements"]
    }
  ],
  "edges": [
    {"from": "concept", "to": "requirements"},
    {"from": "knowledge", "to": "requirements"}
  ]
}
