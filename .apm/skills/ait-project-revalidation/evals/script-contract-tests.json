{
  "version": 1,
  "cases": [
    {
      "id": "reject-project-without-git-repository",
      "script": "scripts/project_review.py",
      "fixture": "evals/script-fixtures/minimal-git-project",
      "command": [
        "{python}",
        "{script}",
        "inventory",
