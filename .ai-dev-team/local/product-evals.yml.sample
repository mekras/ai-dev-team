# Локальные настройки периодической проверки (`apm run product-evals`).
#
# При первом рабочем запуске образец копируется в `.ai-dev-team/local/product-evals.yml`.
# Локальный файл исключён из Git общим правилом `*.local.*`.

client:
  name: codex
  target: codex
  adapter: python3 tools/product-eval-adapters/codex.py
  model: ""

# Последний принятый выпуск, с которым сравнивается текущее дерево проекта.
previous_ref: 0.21.3

# Фиксированный набор не подтверждает бизнес-эффект и не представляет всё
# множество реальных проектов. Проверка начинает с трёх повторений всех
# вариантов и сценариев. Если диапазон пропущенных обязательных действий
# текущей версии больше двух, средство выполняет ещё два повторения в той же
# серии.
evaluation:
  initial_repetitions: 3
  additional_repetitions: 2
  max_missed_action_range: 2
timeout: 1800

# Необязательная смысловая проверка. По умолчанию решение принимает человек по
# сохранённым артефактам. Для модельной проверки задайте command и model.
judge:
  mode: human
# Для модельной проверки замените mode на model и раскомментируйте поля:
# command: .agents/skills/ai-setup-apm/scripts/eval-tools/adapters/codex
# model: gpt-5.4
