# Локальные настройки модельных оценок (`apm run evals`).
#
# При первом запуске образец копируется в `.ai-dev-team/local/evals.yml`. Этот локальный файл
# не попадает в Git.

# Адаптеры моделей: имя адаптера → команда. Контракт адаптера:
# <команда> <модель>; запрос поступает на стандартный ввод, текст ответа — на
# стандартный вывод.
adapters:
#  codex: .agents/skills/ai-setup-apm/scripts/eval-tools/adapters/codex
#  claude: .agents/skills/ai-setup-apm/scripts/eval-tools/adapters/claude

# Модели для применения навыков в формате адаптер:модель. Здесь следует
# использовать слабые модели: прогон должен проверять навык на слабом звене.
models:
  - adapter:sample-model

# Модель-судья в формате адаптер:модель. Следует использовать сильную модель.
judge: adapter:judge-model

# Предельное время одного вызова адаптера в секундах.
timeout: 900
