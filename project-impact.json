{
  "schema_version": 1,
  "graph": {
    "name": "ai-dev-team",
    "description": "Направления возможного влияния между источниками истины, переносимым ядром, проверками и поставкой продукта.",
    "default_facet": "semantic",
    "unmapped_paths": "block",
    "ignore": [
      ".git/**",
      ".agents/**",
      ".claude/**",
      "apm_modules/**",
      "local/**",
      "node_modules/**"
    ]
  },
  "nodes": [
    {
      "id": "concept",
      "title": "Концепция продукта",
      "kind": "concept",
      "paths": ["docs/concept.md"],
      "checks": ["ait-docs-concept"],
      "review_stages": ["requirements"]
    },
    {
      "id": "knowledge",
      "title": "Корпус знаний",
      "kind": "knowledge",
      "paths": ["knowledge/**"],
      "checks": ["kc-validation", "kc-impact-audit"],
      "review_stages": ["repository", "requirements"]
    },
    {
      "id": "requirements",
      "title": "Требования продукта",
      "kind": "requirements",
      "paths": ["requirements.md", "docs/requirements.md", "docs/requirements/**"],
      "checks": ["ait-req-management", "ait-req-validation"],
      "review_stages": ["requirements"]
    },
    {
      "id": "decisions",
      "title": "Проектные решения и открытые задачи",
      "kind": "decision",
      "paths": ["BACKLOG.md", "docs/adr/**", "docs/pdr/**"],
      "checks": ["ait-decisions", "ait-architecture"],
      "review_stages": ["design"]
    },
    {
      "id": "portable-core",
      "title": "Переносимые роли, навыки и инструкции",
      "kind": "implementation",
      "paths": [".apm/**"],
      "checks": ["ai-skill-development", "ait-code-review"],
      "review_stages": ["code"]
    },
    {
      "id": "tooling",
      "title": "Средства разработки и проверки",
      "kind": "implementation",
      "paths": ["tools/**"],
      "checks": ["ait-code-review"],
      "review_stages": ["code"]
    },
    {
      "id": "verification",
      "title": "Постоянные проверки продукта",
      "kind": "test",
      "paths": ["evals/**", "tools/test_*.py"],
      "checks": ["ait-code-testing", "ai-work-result-evaluation"],
      "review_stages": ["tests", "assurance"]
    },
    {
      "id": "project-docs",
      "title": "Документация продукта и разработки",
      "kind": "documentation",
      "paths": [
        "CHANGELOG.md",
        "README.md",
        "docs/development.md",
        "docs/implementation-plan-managed-project-review.md",
        "docs/knowledge.md",
        "docs/overview.md",
        "docs/roles.md"
      ],
      "checks": ["ait-writing", "ait-changelog"],
      "review_stages": ["assurance"]
    },
    {
      "id": "delivery",
      "title": "Настройки разработки и поставки",
      "kind": "delivery",
      "paths": [
        ".ai-dev-team-state.yml",
        ".codex/**",
        ".editorconfig",
        ".gitignore",
        ".markdownlint.json",
        ".prettierignore",
        ".prettierrc.json",
        "AGENTS.md",
        "CLAUDE.md",
        "LICENSE",
        "apm.lock.yaml",
        "apm.yml",
        "evals.local.yml.sample",
        "package-lock.json",
        "package.json",
        "product-evals.local.yml.sample",
        "project-impact.json"
      ],
      "checks": ["ai-setup-apm", "ai-audit-project"],
      "review_stages": ["repository", "assurance"]
    }
  ],
  "edges": [
    {
      "from": "concept",
      "to": "knowledge",
      "relation": "constrains",
      "facets": ["semantic"],
      "rationale": "Состав и применение корпуса оцениваются относительно проблемы, цели и границ продукта."
    },
