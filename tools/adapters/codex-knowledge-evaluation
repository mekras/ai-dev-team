#!/usr/bin/env python3
"""Изолированный адаптер Codex для проверки доступности знаний."""

from __future__ import annotations

import os
import subprocess
import sys
import tempfile
from pathlib import Path


ACCESS_MODES = {"statements", "corpus", "closed_book", "judge"}


def main() -> int:
    if len(sys.argv) != 2 or not sys.argv[1].strip():
        print(
            "Использование: codex-knowledge-evaluation <модель>; запрос на stdin.",
            file=sys.stderr,
        )
        return 2
    if os.environ.get("KC_EVALUATION_READ_ONLY") != "1":
        print("Адаптер требует KC_EVALUATION_READ_ONLY=1.", file=sys.stderr)
        return 2
    access_mode = os.environ.get("KC_EVALUATION_ACCESS")
    if access_mode not in ACCESS_MODES:
        print("Неизвестный режим KC_EVALUATION_ACCESS.", file=sys.stderr)
        return 2

    prompt = sys.stdin.read()
    with tempfile.TemporaryDirectory(prefix="codex-kc-evaluation-") as directory:
        final_path = Path(directory) / "final.txt"
        command = [
            "codex",
            "exec",
            "--ignore-user-config",
            "--ignore-rules",
            "--ephemeral",
            "--skip-git-repo-check",
            "--color",
            "never",
            "--sandbox",
            "read-only",
            "--model",
            sys.argv[1],
            "-c",
            "project_doc_max_bytes=0",
            "--output-last-message",
            str(final_path),
            "-",
        ]
        completed = subprocess.run(
            command,
            input=prompt,
            text=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            check=False,
        )
        if completed.returncode:
            print(completed.stderr, file=sys.stderr, end="")
            return completed.returncode
        if not final_path.is_file():
            print("Codex не создал файл итогового ответа.", file=sys.stderr)
            return 1
        sys.stdout.write(final_path.read_text(encoding="utf-8"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
